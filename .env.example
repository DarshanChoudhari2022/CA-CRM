# Supabase browser-safe values only. Never commit the database password or service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://ostvciecjwbzyzzyksnf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Server-side only, for migrations/administration outside the browser.
SUPABASE_DB_URL=postgresql://postgres:replace-with-password@db.ostvciecjwbzyzzyksnf.supabase.co:5432/postgres

# Required for server-side employee login creation and initial admin bootstrap.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# One-time main admin bootstrap. Generates a temporary password if the Auth user is new.
BOOTSTRAP_ADMIN_EMAIL=office@psbassociates.in
BOOTSTRAP_ADMIN_NAME=PSB Administrator

# Optional CRM integrations. All of these are server-only (no NEXT_PUBLIC_ prefix).
GROQ_API_KEY=
GROQ_MODEL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=office@psbassociates.in
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_PROVIDER=meta
# Authkey demo: approved leave template only. API key is a server secret.
AUTHKEY_API_KEY=
AUTHKEY_TEMPLATE_ID=52797
AUTHKEY_COUNTRY_CODE=91

# Durable CRM automation (server-only). Keep paused until configured and tested.
CRM_AUTOMATION_ORGANIZATION_ID=
CRON_SECRET=
CRM_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Dedicated Gmail label ID for approved incoming enquiries; OAuth gmail.modify required.
GMAIL_INTAKE_LABEL_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_PARTNER_CHAT_ID=

# Leave emails use the same provider as the PSB website contact form.
# Use a Web3Forms key verified for the intended receiving mailbox.
# Set this to the same value as WEB3FORMS_ACCESS_KEY in the PSB website.
WEB3FORMS_ACCESS_KEY=
# Optional override if leave notifications should use a different form key.
LEAVE_WEB3FORMS_ACCESS_KEY=
LEAVE_NOTIFICATION_ORGANIZATION_ID=
# Optional server worker: requires paid Web3Forms plan and server IP allowlisting.
LEAVE_WEB3FORMS_SERVER_ENABLED=false

