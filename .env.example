# Supabase browser-safe values only. Never commit the database password or service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://ostvciecjwbzyzzyksnf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Server-side only, for migrations/administration outside the browser.
SUPABASE_DB_URL=postgresql://postgres:replace-with-password@db.ostvciecjwbzyzzyksnf.supabase.co:5432/postgres

# Required only by the protected admin invitation route on the server.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# One-time bootstrap after creating this Auth user in the Supabase dashboard.
BOOTSTRAP_ADMIN_EMAIL=partner@example.com
BOOTSTRAP_ADMIN_NAME=PSB Partner

